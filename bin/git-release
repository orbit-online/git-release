#!/usr/bin/env bash
# shellcheck source-path=..

main() {
  set -eo pipefail; shopt -s inherit_errexit
  local pkgroot; pkgroot=$(realpath "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/..")
  source "$pkgroot/.upkg/records.sh/records.sh"
  DOC="git-release - Tag REF by either bumping the last version or specifying one
Usage:
  git-release [-p P] previous [REF]
  git-release [-p P options] (major|minor|patch) [REF]
  git-release [-p P options] VERSION [REF]

Options:
  -p --prefix P   Operate on versions tagged as '\$PX.Y.Z' [default: v]
  --push          Push the new tag and branch upstream
  --ignore-dirty  Ignore a dirty working copy when REF is HEAD
  -n, --dry-run   Show the commands instead of running them and show changelog
  -h, --help      Show this screen

Notes:
  git-release automatically determines the previous version using git-describe
  and then bumps the specified part of that version.
  Use \`git-release previous' to show the previous version based on REF.
  REF defaults to HEAD.
"
# docopt parser below, refresh this parser with `docopt.sh git-release`
# shellcheck disable=2016,2086,2317,1090,1091,2034
docopt() { local v='2.0.2'; source \
"$pkgroot/.upkg/docopt-lib-v$v/docopt-lib.sh" "$v" || { ret=$?;printf -- "exit \
%d\n" "$ret";exit "$ret";};set -e;trimmed_doc=${DOC:0:764};usage=${DOC:75:140}
digest=587a3;options=('-p --prefix 1' ' --push 0' ' --ignore-dirty 0' '-n --dr'\
'y-run 0' '-h --help 0');node_0(){ value __prefix 0;};node_1(){ switch __push 1
};node_2(){ switch __ignore_dirty 2;};node_3(){ switch __dry_run 3;};node_4(){
switch __help 4;};node_5(){ value REF a;};node_6(){ value VERSION a;};node_7(){
switch previous a:previous;};node_8(){ switch major a:major;};node_9(){ switch \
minor a:minor;};node_10(){ switch patch a:patch;};node_11(){ sequence 12 7 13;}
node_12(){ optional 0;};node_13(){ optional 5;};node_14(){ sequence 15 16 13;}
node_15(){ optional 0 1 2 3 4;};node_16(){ choice 8 9 10;};node_17(){ sequence \
15 6 13;};node_18(){ choice 11 14 17;};cat <<<' docopt_exit() { [[ -n $1 ]] && \
printf "%s\n" "$1" >&2;printf "%s\n" "${DOC:75:140}" >&2;exit 1;}';local \
varnames=(__prefix __push __ignore_dirty __dry_run __help REF VERSION previous \
major minor patch) varname;for varname in "${varnames[@]}"; do unset \
"var_$varname";done;parse 18 "$@";local p=${DOCOPT_PREFIX:-''};for varname in \
"${varnames[@]}"; do unset "$p$varname";done;eval $p'__prefix=${var___prefix:-'\
'v};'$p'__push=${var___push:-false};'$p'__ignore_dirty=${var___ignore_dirty:-f'\
'alse};'$p'__dry_run=${var___dry_run:-false};'$p'__help=${var___help:-false};'\
$p'REF=${var_REF:-};'$p'VERSION=${var_VERSION:-};'$p'previous=${var_previous:-'\
'false};'$p'major=${var_major:-false};'$p'minor=${var_minor:-false};'$p'patch='\
'${var_patch:-false};';local docopt_i=1;[[ $BASH_VERSION =~ ^4.3 ]] && \
docopt_i=2;for ((;docopt_i>0;docopt_i--)); do for varname in "${varnames[@]}"; \
do declare -p "$p$varname";done;done;}
# docopt parser above, complete command for generating this parser is `docopt.sh --library='"$pkgroot/.upkg/docopt-lib-v$v/docopt-lib.sh"' git-release`
  eval "$(docopt "$@")"

  # shellcheck disable=2154
  local P=$__prefix
  [[ -n $REF ]] || REF=HEAD

  local v_major v_minor v_patch _rest previous_version
  if previous_version=$(git describe --tag --abbrev=0 --match="${P}*" "$REF" 2>/dev/null); then
    # shellcheck disable=2034
    IFS=.-+ read -r -d $'\n' v_major v_minor v_patch _rest <<<"${previous_version#"$P"}"
  else
    v_major=0
    v_minor=0
    v_patch=0
  fi

  # shellcheck disable=2154
  if $previous; then
    [[ -n $previous_version ]] || fatal "No version tag found based on %s" "$REF"
    printf -- "%s\n" "$previous_version"
    return 0
  fi

  local new_version
  # shellcheck disable=2154
  if $major || $minor || $patch; then
    if $major || $minor; then
      if $major; then
        v_major=$((v_major+1))
        v_minor=0
      else
        v_minor=$((v_minor+1))
      fi
      v_patch=0
    else
      v_patch=$((v_patch+1))
    fi
    new_version=$(printf -- "%s%s.%s.%s\n" "$P" "$v_major" "$v_minor" "$v_patch")
  else
    [[ $VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-].+)?$ ]] || docopt_exit "\`$VERSION' is not in prefix-less semver format."
    new_version=${P}${VERSION}
  fi

  # shellcheck disable=2154
  if [[ $REF = HEAD ]] && ! $__ignore_dirty && (! git diff --no-ext-diff --quiet --exit-code || ! git diff-index --quiet --cached HEAD 2>/dev/null); then
    fatal "Working copy is dirty, refusing to release"
  fi

  local release_notes
  if [[ -n $previous_version ]]; then
    [[ -n $(git rev-list --format=%s "$REF...$previous_version") ]] || \
      fatal "The version you intend to release and the previous version (%s) are the same git ref (%s)" "$previous_version" "$REF"
    release_notes="# Release notes were prepared for you, categorize/remove the changes as you see fit.
Changes since $previous_version:
---
$(git rev-list --format=%s "$REF...$previous_version" | grep -Pv '^commit ' | sed 's/^/* /g')
"
  else
    release_notes="# Release notes were prepared for you, describe the first release.
Initial release.
"
  fi
  local tag_msg_file
  tag_msg_file=$(git rev-parse --git-dir)/TAG_EDITMSG

  local ret=0
  #shellcheck disable=2154
  if $__dry_run; then
    #shellcheck disable=2028
    echo printf -- \"%s\\n\" "\"$release_notes\"" \> "\"$tag_msg_file\""
    echo git tag -e -F "$tag_msg_file" "$new_version" "$REF"
  else
    printf -- "%s\n" "$release_notes" > "$tag_msg_file"
    if ! git tag -e -F "$tag_msg_file" "$new_version" "$REF"; then
      # shellcheck disable=2183
      error "Unable to tag %s with %s, the version might already exist on a different branch.
You can list all versions with \`git tag -l --sort taggerdate '%s*'' and then tag manually with \`git tag -e -F %s %s %s'" "$REF" "$new_version" "$P" "$tag_msg_file" "$new_version" "$REF"
      ret=1
    else
      info "%s tagged with %s" "$REF" "$new_version"
    fi
  fi

  local branch upstream
  if ! branch=$(git symbolic-ref --short "$REF" 2>/dev/null) || ! upstream=$(git config "branch.$branch.remote" 2>/dev/null); then
    #shellcheck disable=2154
    if $__push; then
      fatal "Failed to determine current branch or its upstream, unable to push the new version"
    fi
  elif $__push; then
    git push --atomic "$upstream" "$branch" "$new_version"
  else
    info "Release the new version by running \`git push --atomic %s %s %s' (or use \`--push' next time)\n" "$upstream" "$branch" "$new_version"
  fi
  return $ret
}

main "$@"
